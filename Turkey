if(e.target.closest("[data-cex]")){st.cex=!st.cex;drawCities();return}
const cc=e.target.closest(".cc");if(cc){st.city=cc.dataset.city;drawChips();render();$("#catalog").scrollIntoView({behavior:"smooth",block:"start"});return}
const b=e.target.closest(".brick");if(b){const k=b.dataset.b;st.cat=st.cat===k?"all":k;st.main=true;bricks();render();if(st.cat!=="all")$("#catalog").scrollIntoView({behavior:"smooth",block:"start"});return}
if(e.target.closest("[data-main]")){st.main=!st.main;render();return}
if(e.target.closest("[data-clr]")){st.cat="all";bricks();render();return}
const c=e.target.closest(".chip");if(c&&c.dataset.k){st[c.dataset.k]=c.dataset.v;drawChips();render();return}
const card=e.target.closest(".card");if(card){openUni(card.dataset.id);return}
if(e.target.closest("#bk")||e.target.closest("#logo")){closeUni();return}
const tb=e.target.closest(".tab");
if(tb){const u=DB.find(x=>x.id===String(st.id));document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("on",x===tb));$("#pn").innerHTML=pane(u,+tb.dataset.t)}});
$("#q").addEventListener("input",e=>{st.q=e.target.value;if(st.id!==null||st.v!=="cat"){st.id=null;$("#view").classList.remove("on");show("cat")}render()});
["#gv","#gs","#ga"].forEach(s=>$(s).addEventListener("input",calc));
$("#hbg").style.backgroundImage=`url('${wm("ist",2000)}')`;
$("#glass").style.backgroundImage=`url('${wm("cap",600)}')`;
stats();cities();bricks();drawChips();render();
</script>
</body>
</html>
